# Firebase Web SDK Configuration (for Online Multiplayer & Android <-> Web Cross-Play)
# Get these values from Firebase Console -> Project Settings -> Your apps -> Web app
# Project default from .firebaserc: unochess-online
# Copy this file to .env and fill in your Firebase Web App credentials.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=unochess-online.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=unochess-online
VITE_FIREBASE_STORAGE_BUCKET=unochess-online.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
