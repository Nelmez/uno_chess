rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /lobbies/{code}
// Document ID: Room code (4 to 8 characters, uppercase alphanumeric)
// Fields:
//   - code: string (required, immutable) - Room code, must match document ID
//   - hostId: string (required, immutable, 8 to 64 chars) - Host player UUID
//   - hostName: string (required, immutable, 1 to 24 chars) - Host display name
//   - status: string (required, enum: 'waiting' | 'playing' | 'closed') - Match status
//   - createdAt: number (required, immutable) - Creation epoch milliseconds (int or float)
//   - hostSeenAt: number (required) - Host heartbeat epoch milliseconds (int or float)
//   - stateSeq: number (required, >= 0) - State sequence counter (int or float)
//   - guestId: string (optional, 8 to 64 chars) - Guest player UUID (present when status is 'playing' or 'closed')
//   - guestName: string (optional, 1 to 24 chars) - Guest display name
//   - guestSeenAt: number (optional) - Guest heartbeat epoch milliseconds (int or float)
//   - state: string (optional, <= 900,000 chars) - Serialized game state
//   - enabledSpecials: list of strings (optional, immutable, <= 32 items) - Optional enabled special card keys
//
// Collection: /lobbies/{code}/actions/{actionId}
// Document ID: Auto-generated Firestore document ID
// Fields:
//   - fromId: string (required, 8 to 64 chars) - Must match parent lobby guestId
//   - line: string (required, 1 to 900,000 chars) - Serialized move payload
//   - createdAt: number (required) - Action creation epoch milliseconds (int or float)
//
// Note: Authentication is anonymous player-id based (stored locally in SharedPreferences or localStorage,
// passed in document fields). Firebase Auth (request.auth) is not used.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isValidPlayerId(id) {
      return id is string && id.size() >= 8 && id.size() <= 64;
    }

    function isValidDisplayName(name) {
      return name is string && name.size() >= 1 && name.size() <= 24;
    }

    function isValidRoomCode(code) {
      return code is string && code.matches('^[A-Z0-9]{4,8}$');
    }

    function parentLobby(code) {
      return get(/databases/$(database)/documents/lobbies/$(code)).data;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validates lobby document schema, field types, and size constraints
    function isValidLobbyDoc(data) {
      return data.keys().hasOnly(['code', 'hostId', 'hostName', 'status', 'createdAt', 'hostSeenAt', 'stateSeq', 'guestId', 'guestName', 'guestSeenAt', 'state', 'enabledSpecials'])
        && data.keys().hasAll(['code', 'hostId', 'hostName', 'status', 'createdAt', 'hostSeenAt', 'stateSeq'])
        && isValidRoomCode(data.code)
        && isValidPlayerId(data.hostId)
        && isValidDisplayName(data.hostName)
        && data.status in ['waiting', 'playing', 'closed']
        && data.createdAt is number
        && data.hostSeenAt is number
        && data.stateSeq is number && data.stateSeq >= 0
        && (
          !('guestId' in data) || data.guestId == null ||
          isValidPlayerId(data.guestId)
        )
        && (
          !('guestName' in data) || data.guestName == null ||
          isValidDisplayName(data.guestName)
        )
        && (
          !('guestSeenAt' in data) || data.guestSeenAt == null ||
          data.guestSeenAt is number
        )
        && (
          !('state' in data) || data.state == null ||
          (data.state is string && data.state.size() <= 900000)
        )
        && (
          !('enabledSpecials' in data) || data.enabledSpecials == null ||
          (data.enabledSpecials is list && data.enabledSpecials.size() <= 32)
        );
    }

    // Validates action subcollection document schema and constraints
    function isValidActionDoc(code, data) {
      return exists(/databases/$(database)/documents/lobbies/$(code))
        && parentLobby(code).status == "playing"
        && ('guestId' in parentLobby(code))
        && data.fromId == parentLobby(code).guestId
        && data.keys().hasOnly(['fromId', 'line', 'createdAt'])
        && data.keys().hasAll(['fromId', 'line', 'createdAt'])
        && isValidPlayerId(data.fromId)
        && data.line is string
        && data.line.size() > 0
        && data.line.size() < 900000
        && data.createdAt is number;
    }

    // ===============================================================
    // Transition Validation for /lobbies/{code} Updates
    // ===============================================================

    function areImmutableFieldsUnchanged(code) {
      return request.resource.data.code == resource.data.code
        && request.resource.data.code == code
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.hostName == resource.data.hostName
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enabledSpecials']);
    }

    // Transition A: Host heartbeat while waiting (or guest disconnect reset)
    function isHostWaitingHeartbeat() {
      return resource.data.status == "waiting"
        && request.resource.data.status == "waiting"
        && (!('guestId' in request.resource.data) || request.resource.data.guestId == null)
        && (!('state' in request.resource.data) || request.resource.data.state == null)
        && request.resource.data.stateSeq == resource.data.stateSeq;
    }

    // Transition B: Guest joining the waiting lobby
    function isGuestJoining() {
      return resource.data.status == "waiting"
        && request.resource.data.status == "playing"
        && (!('guestId' in resource.data) || resource.data.guestId == null)
        && ('guestId' in request.resource.data)
        && isValidPlayerId(request.resource.data.guestId)
        && request.resource.data.guestId != resource.data.hostId
        && ('guestName' in request.resource.data)
        && isValidDisplayName(request.resource.data.guestName)
        && ('guestSeenAt' in request.resource.data)
        && request.resource.data.guestSeenAt is number
        && (!('state' in request.resource.data) || request.resource.data.state == null)
        && request.resource.data.stateSeq == resource.data.stateSeq;
    }

    // Transition C: Active gameplay updates (Host syncing state, Host/Guest heartbeat)
    function isActiveGameplayUpdate() {
      return resource.data.status == "playing"
        && request.resource.data.status == "playing"
        && ('guestId' in resource.data)
        && ('guestId' in request.resource.data)
        && request.resource.data.guestId == resource.data.guestId
        && request.resource.data.get('guestName', null) == resource.data.get('guestName', null)
        && request.resource.data.stateSeq is number
        && request.resource.data.stateSeq >= resource.data.stateSeq
        && (
          !('state' in request.resource.data) ||
          request.resource.data.state == null ||
          (request.resource.data.state is string && request.resource.data.state.size() <= 900000)
        );
    }

    // Transition D: Closing the lobby (Host cancelling or either player leaving)
    function isLobbyClosing() {
      return resource.data.status in ['waiting', 'playing']
        && request.resource.data.status == "closed"
        && (
          request.resource.data.get('guestId', null) == resource.data.get('guestId', null)
          || (resource.data.status == "waiting" && (!('guestId' in request.resource.data) || request.resource.data.guestId == null))
        );
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    match /lobbies/{code} {
      allow read: if true;

      allow create: if isValidLobbyDoc(request.resource.data)
        && request.resource.data.code == code
        && request.resource.data.status == "waiting"
        && request.resource.data.stateSeq == 0
        && (!('guestId' in request.resource.data) || request.resource.data.guestId == null)
        && (!('guestName' in request.resource.data) || request.resource.data.guestName == null)
        && (!('guestSeenAt' in request.resource.data) || request.resource.data.guestSeenAt == null)
        && (!('state' in request.resource.data) || request.resource.data.state == null);

      allow update: if isValidLobbyDoc(request.resource.data)
        && areImmutableFieldsUnchanged(code)
        && (
          isHostWaitingHeartbeat()
          || isGuestJoining()
          || isActiveGameplayUpdate()
          || isLobbyClosing()
        );

      allow delete: if false;

      match /actions/{actionId} {
        allow read: if true;

        allow create: if isValidActionDoc(code, request.resource.data);

        allow update, delete: if false;
      }
    }
  }
}
