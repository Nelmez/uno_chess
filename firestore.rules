rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function lobby(code) {
      return get(/databases/$(database)/documents/lobbies/$(code)).data;
    }

    match /lobbies/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.guestId == null
        && request.resource.data.status == "waiting"
        && request.resource.data.code == code
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 24
        && request.resource.data.state == null
        && request.resource.data.stateSeq == 0;

      allow update: if signedIn() && (
        (
          resource.data.hostId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
        )
        || (
          resource.data.status == "waiting"
          && resource.data.guestId == null
          && request.resource.data.guestId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.status == "playing"
          && request.resource.data.code == resource.data.code
          && request.resource.data.state == resource.data.state
          && request.resource.data.stateSeq == resource.data.stateSeq
        )
        || (
          resource.data.guestId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.guestId == resource.data.guestId
          && request.resource.data.code == resource.data.code
          && request.resource.data.state == resource.data.state
          && request.resource.data.stateSeq == resource.data.stateSeq
          && (
            request.resource.data.status == resource.data.status
            || request.resource.data.status == "closed"
          )
        )
      );

      allow delete: if false;

      match /actions/{actionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && lobby(code).guestId == request.auth.uid
          && lobby(code).status == "playing"
          && request.resource.data.fromId == request.auth.uid
          && request.resource.data.line is string
          && request.resource.data.line.size() > 0
          && request.resource.data.line.size() < 900000
          && request.resource.data.createdAt is int;
        allow update, delete: if false;
      }
    }
  }
}
